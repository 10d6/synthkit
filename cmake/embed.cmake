# Generates a .cpp embedding synth.json and presets/*.json as byte arrays.
# Run with: cmake -DSYNTH_DIR=... -DOUT=... -P embed.cmake
# (Byte arrays rather than string literals: MSVC caps literal length.)

function(_sk_hex_array var file)
  file(READ "${file}" hex HEX)
  string(LENGTH "${hex}" len)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  set(${var} "${bytes}0x00" PARENT_SCOPE)
endfunction()

_sk_hex_array(synth_bytes "${SYNTH_DIR}/synth.json")
set(src "// Generated by synthkit/cmake/embed.cmake. Do not edit.\n#include \"synthkit/engine.h\"\n\nnamespace {\n")
string(APPEND src "const char kSynthJson[] = {${synth_bytes}};\n")

file(GLOB presets RELATIVE "${SYNTH_DIR}" "${SYNTH_DIR}/presets/*.json")
list(SORT presets)
set(i 0)
set(table "")
foreach(p IN LISTS presets)
  _sk_hex_array(b "${SYNTH_DIR}/${p}")
  string(APPEND src "const char kPreset${i}[] = {${b}};\n")
  string(APPEND table "  {\"${p}\", kPreset${i}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND src "const sk::EmbeddedPreset kPresets[] = {\n${table}  {nullptr, nullptr}\n};\n")
string(APPEND src "}  // namespace\n\nnamespace sk {\n")
string(APPEND src "const char* embeddedSynthJson() { return kSynthJson; }\n")
string(APPEND src "const EmbeddedPreset* embeddedPresets(int& count) { count = ${i}; return kPresets; }\n")
string(APPEND src "}  // namespace sk\n")

# Only rewrite when content changes, so builds stay incremental.
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL src)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${src}")
